# API: the API reads the repository's .env at start; exported shell variables win.
PORT=8787

# Address the API listens on. Keep 127.0.0.1 unless a reverse proxy (with HTTPS) runs on another machine.
# REX_HOST=127.0.0.1
# Extra browser origin allowed to call the API, e.g. https://rex.example.com when the web app is hosted separately.
# REX_WEB_ORIGIN=https://rex.example.com
# Allows members to connect private model-provider URLs. Bot fetches still refuse private addresses.
# REX_ALLOW_PRIVATE_FETCH=1

# Encrypts saved provider keys. Without it the API creates <data>/secret.key on first use; keep that file
# with the database, or users have to paste their keys again.
# REX_SECRET_KEY=a-long-random-string

# Accounts: the first account created becomes the admin. Sign-up is closed afterwards until an
# admin opens it in Admin → Settings.

# Optional absolute directory for SQLite and uploaded files.
# REX_DATA_DIR=/absolute/path/to/rexbot-data

# Web: set this in apps/web/.env.local when changing the API address.
# VITE_API_URL=http://localhost:8787
# Production builds use the website's own origin by default. Set REX_WEB_ORIGIN to its HTTPS origin.
# REX_WEB_ORIGIN=https://rex.example.com
# REX_WEB_DIST=/absolute/path/to/apps/web/dist

# Model providers are connected per account in Settings → Models (keys encrypted on the server).
# The Tavily and Google keys are still set in Settings and kept in the browser.

# Rex Computer: qemu (default, one VM per account, a screen per bot) or podman (offline sandbox, no screen).
# QEMU setup: scripts/qemu/setup-host.sh, then Admin → Computers → Build image. Details: docs/qemu-computer.md
# REX_COMPUTER_BACKEND=qemu
# REX_VM_DIR=/absolute/path/to/vms
# REX_QEMU_ACCEL=tcg            # force software emulation when /dev/kvm is missing or broken
# REX_VM_PROXY_PORT=19382       # loopback-only public-site proxy; keep stable across API restarts
# REX_QEMU_BASE_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
