# API: export these variables in the shell running pnpm dev:api.
PORT=8787

# Optional absolute directory for SQLite and uploaded files.
# REX_DATA_DIR=/absolute/path/to/rexbot-data

# Web: set this in apps/web/.env.local when changing the API address.
# VITE_API_URL=http://localhost:8787

# Model and Tavily keys are configured in the app's Settings, not in this file.
