# API: the API reads the repository's .env at start; exported shell variables win.
PORT=8787

# Optional absolute directory for SQLite and uploaded files.
# REX_DATA_DIR=/absolute/path/to/rexbot-data

# Web: set this in apps/web/.env.local when changing the API address.
# VITE_API_URL=http://localhost:8787

# Model and Tavily keys are configured in the app's Settings, not in this file.

# Rex Computer backend: podman (local sandbox) or proxmox (shared VM, one desktop per bot).
# Easiest: open the computer panel → "Set up Proxmox desktop" (POST /computer/bootstrap).
# That writes the block below. Manual setup: scripts/proxmox-rex-computer.md
# REX_COMPUTER_BACKEND=proxmox
# REX_PROXMOX_URL=https://192.168.100.25:8006
# REX_PROXMOX_NODE=pve
# REX_PROXMOX_VMID=180
# REX_PROXMOX_VM_NAME=rex-computer
# REX_PROXMOX_TOKEN_ID=rex@pve!rex
# REX_PROXMOX_TOKEN_SECRET=
# REX_PROXMOX_INSECURE_TLS=1
# REX_PROXMOX_CA_FILE=/path/to/pve-root-ca.pem
# REX_COMPUTER_SSH_HOST=192.168.100.50
# REX_COMPUTER_SSH_USER=rex
# REX_COMPUTER_SSH_PORT=22
# REX_COMPUTER_SSH_KEY=~/.ssh/rex_computer
# REX_COMPUTER_SSH_KNOWN_HOSTS=~/.ssh/rex_computer_known_hosts
# REX_COMPUTER_TUNNEL_PORT=46080
